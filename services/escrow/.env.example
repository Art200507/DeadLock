# Copy to services/escrow/.env (git-ignored) and fill in. Never commit the real file.

# Database: a Postgres URL, or an in-process PGlite database for local development.
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require
ESCROW_DB=pglite:memory

# Key wrapping: "aws" for real KMS, "mock" for local development (never production).
KMS_PROVIDER=mock
# KMS_KEY_ID=alias/condition-lock
# AWS_REGION=us-east-1
# AWS credentials come from the standard AWS chain (AWS_PROFILE, SSO, env vars).
# AWS_PROFILE=condition-lock

# Bearer token for POST /devices (device registration). Generate one: openssl rand -hex 32
# ESCROW_ADMIN_TOKEN=

# Key-release verifier: a socket (production: bridged to the Nitro Enclave over vsock),
# or in-process for local development.
VERIFIER_INPROCESS=1
# VERIFIER_SOCKET=/run/condlock/verifier.sock

# --- Only for `pnpm test:real-kms` (see services/escrow/README.md) ---
# CONDLOCK_REAL_KMS_KEY_ID=alias/condition-lock
