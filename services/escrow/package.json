{
  "name": "@condlock/escrow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx --conditions=development --env-file-if-exists=.env src/server.ts",
    "test": "tsx --conditions=development --test test/*.test.ts",
    "test:offline": "tsx --conditions=development --test test/*.test.ts",
    "test:real-kms": "tsx --conditions=development --env-file-if-exists=.env --test test/real/*.test.ts",
    "verifier": "tsx --conditions=development --env-file-if-exists=.env src/verifier/main.ts",
    "test:live-sports": "tsx --conditions=development --env-file-if-exists=.env --test test/live/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1178.0",
    "@aws-sdk/credential-provider-node": "3.972.99",
    "@condlock/core": "workspace:*",
    "@electric-sql/pglite": "^0.6.0",
    "@hono/node-server": "^2.1.11",
    "@peculiar/asn1-cms": "^3.1.0",
    "@peculiar/asn1-rsa": "^3.1.0",
    "@peculiar/asn1-schema": "^3.1.0",
    "@peculiar/asn1-x509": "^3.1.0",
    "@smithy/node-http-handler": "4.14.2",
    "age-encryption": "0.3.1",
    "drand-client": "1.2.5",
    "hono": "^4.13.22",
    "pg": "^8.23.1",
    "shamir-secret-sharing": "0.0.4"
  },
  "devDependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@peculiar/x509": "3.1.0",
    "@types/pg": "^8.23.1",
    "reflect-metadata": "0.2.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
